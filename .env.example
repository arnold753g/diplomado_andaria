# APP
APP_ENV=development
APP_NAME=Andaria
APP_SHORT_NAME=Andaria
LOG_LEVEL=debug

# FRONTEND
NUXT_PUBLIC_API_BASE=http://localhost:8080/api/v1
NUXT_PUBLIC_REGISTRATION_ENABLED=true
FRONTEND_PORT=3000

# BACKEND
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
BACKEND_PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# DATABASE
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-with-a-local-database-password
DB_NAME=proyecto_base_1
DB_SSLMODE=disable
DB_AUTO_MIGRATE=true

# AUTH / SECURITY
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL=12h
SESSION_IDLE_TIMEOUT=30m
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
PASSWORD_BCRYPT_COST=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT=15m
AUTH_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=120
REGISTRATION_ENABLED=true

# DEVELOPMENT SEED (never enabled in production)
SEED_DEVELOPMENT=false
DEV_ADMIN_EMAIL=admin@example.test
DEV_ADMIN_PASSWORD=replace-with-a-development-password
DEV_USER_EMAIL=user@example.test
DEV_USER_PASSWORD=replace-with-a-development-password


# GOOGLE: set all three to enable. Client secret remains on the backend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
FRONTEND_URL=http://localhost:3000
# Local callback when enabled: http://localhost:8080/api/v1/auth/google/callback

# Vector map style and raster fallback. Update the Nginx CSP when changing hosts.
NUXT_PUBLIC_MAP_STYLE_URL=/maps/openfreemap-liberty.json
NUXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
