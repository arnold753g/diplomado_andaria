# Copy this file to .env.production on the server and replace every placeholder.
# Never commit .env.production.

APP_NAME=Andaria
APP_SHORT_NAME=Andaria
LOG_LEVEL=info

# Public HTTPS origin. Use the same origin unless frontend and API are separated.
ALLOWED_ORIGINS=https://andaria.example
FRONTEND_URL=https://andaria.example
NUXT_PUBLIC_API_BASE=https://andaria.example/api/v1
REGISTRATION_ENABLED=true

# Nginx stays private when a TLS proxy such as Caddy, Traefik or a cloud load balancer is used.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8088
TRUST_PROXY=false
# After inspecting Docker, set true and list only the immediate Nginx peer CIDRs.
TRUSTED_PROXY_CIDRS=

# PostgreSQL is private to Docker, so SSL can remain disabled for this local container network.
DB_NAME=andaria
DB_ADMIN_USER=andaria
DB_ADMIN_PASSWORD=replace-with-the-existing-bootstrap-password
DB_MIGRATION_USER=andaria_migrator
DB_MIGRATION_PASSWORD=replace-with-a-distinct-random-migration-password
DB_USER=andaria_api
DB_PASSWORD=replace-with-a-long-random-database-password
DB_SSLMODE=disable

SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL=12h
SESSION_IDLE_TIMEOUT=30m
AUTH_COOKIE_SAME_SITE=lax
PASSWORD_BCRYPT_COST=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT=15m
AUTH_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=120

# Optional Google access. Configure all three values or leave all three empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# When enabled: https://andaria.example/api/v1/auth/google/callback
GOOGLE_REDIRECT_URL=

# Password registration requires email verification. Without SMTP, Google and
# existing accounts still work; new password registrations return unavailable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Enable only during CSP observation, then return to false after browser checks.
NUXT_CSP_REPORT_ONLY=false
