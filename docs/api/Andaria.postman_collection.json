        "description": "Cancelar compra de prueba. Cookie de sesión administrada por Postman; autorización por rol y propiedad aplicada en servidor.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"version\": {{version}},\n  \"reason\": \"Cancelación ficticia\",\n  \"refund_method\": \"bank_transfer\",\n  \"refund_bank_name\": \"Banco de prueba\",\n  \"refund_account_holder\": \"Titular ficticio\",\n  \"refund_account_number\": \"000000\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
