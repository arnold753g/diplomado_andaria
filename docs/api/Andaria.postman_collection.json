          ]
        },
        "description": "Crear paquete en borrador. Cookie de sesión administrada por Postman; autorización por rol y propiedad aplicada en servidor.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Paquete de prueba\",\n  \"duration_days\": 1,\n  \"duration_nights\": 0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Consultar opciones de pago",
