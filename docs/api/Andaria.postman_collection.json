          ],
          "path": [
            "api",
            "v1",
            "agency",
            "purchases",
            "{{purchaseId}}",
            "review"
          ]
        },
        "description": "Revisar pago como agencia. Cookie de sesión administrada por Postman; autorización por rol y propiedad aplicada en servidor.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"version\": {{version}},\n  \"decision\": \"confirm\",\n  \"reason\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Cancelar compra de prueba",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
