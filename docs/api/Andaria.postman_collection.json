{
  "info": {
    "name": "Andaria - contrato principal",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Contrato exportado de la revisión local del 11/10/2026. No ejecutar todas las operaciones como una secuencia en producción. Login turista y agencia requieren sesiones distintas. Las mutaciones usan datos ficticios y revisión de versiones. Salud pendiente de redespliegue. Variables sensibles vacías; no incluye pruebas de rendimiento."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://diplomado.andaria.site",
      "type": "string"
    },
    {
      "key": "email",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "csrfToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "packageId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "departureId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "purchaseId",
      "value": "",
      "type": "string"
    },
    {
      "key": "version",
      "value": "1",
      "type": "string"
    },
    {
      "key": "proofDataUri",
      "value": "",
      "type": "string"
    },
    {
      "key": "expectedTotalCents",
      "value": "10000",
      "type": "string"
    },
    {
      "key": "requestKey",
      "value": "demo-idempotencia-0001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Salud de API y PostgreSQL",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/salud",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "salud"
          ]
        },
        "description": "Salud de API y PostgreSQL. Cookie de sesión administrada por Postman; autorización por rol y propiedad aplicada en servidor."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"API y PostgreSQL disponibles\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.database).to.eql(\"ok\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Iniciar sesión",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{baseUrl}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "description": "Iniciar sesión. Cookie de sesión administrada por Postman; autorización por rol y propiedad aplicada en servidor.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) { pm.collectionVariables.set(\"csrfToken\", pm.response.json().data.csrf_token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Consultar atractivos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/attractions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "attractions"
          ]
        },
        "description": "Consultar atractivos. Cookie de sesión administrada por Postman; autorización por rol y propiedad aplicada en servidor."
      },
      "response": []
    },
    {
      "name": "Consultar paquetes",
      "request": {
        "method": "GET",
