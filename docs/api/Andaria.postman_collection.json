      },
      "response": []
    },
    {
      "name": "Crear compra de prueba",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{baseUrl}}"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{requestKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/me/purchases",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "me",
            "purchases"
          ]
        },
        "description": "Crear compra de prueba. Cookie de sesión administrada por Postman; autorización por rol y propiedad aplicada en servidor.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"departure_id\": {{departureId}},\n  \"payment_method\": \"transfer\",\n  \"national_adults\": 1,\n  \"foreign_adults\": 0,\n  \"minors\": [],\n  \"payment_proof\": \"{{proofDataUri}}\",\n  \"expected_total_cents\": {{expectedTotalCents}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
