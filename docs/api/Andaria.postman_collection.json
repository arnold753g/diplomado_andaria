      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/me/purchases/{{purchaseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "me",
            "purchases",
            "{{purchaseId}}"
          ]
        },
        "description": "Consultar compra propia. Cookie de sesión administrada por Postman; autorización por rol y propiedad aplicada en servidor."
      },
      "response": []
